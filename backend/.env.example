# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/shorts_generator
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_RETRIES=8
MONGO_RETRY_DELAY_MS=5000
NODE_ENV=development

# Groq (used for transcription via Whisper + best-moment analysis via Llama)
GROQ_API_KEYS=gsk_key_one,gsk_key_two
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_ANALYSIS_MODEL=openai/gpt-oss-120b

# Optional: absolute path to a Netscape-format cookies.txt file for a dedicated
# YouTube account. Keep this file outside the repository and configure it as a
# secret on the deployed server. Required only when YouTube blocks server-side
# downloads with a "Sign in to confirm you're not a bot" message.
YTDLP_COOKIES_FILE=

# Storage
STORAGE_DIR=./storage

STORAGE_MAX_AGE_MINUTES=90
STORAGE_SWEEP_INTERVAL_MINUTES=30

# Uploads are stored and processed at their original quality — never
# re-encoded/compressed — and large files are sent to the server in
# parallel chunks (see frontend/src/api/client.js) so this cap can be sized
# for raw footage rather than a pre-shrunk file. Must stay in sync with
# UPLOAD_CHUNK_SIZE below and MAX_UPLOAD_BYTES in frontend/src/pages/Home.jsx.
MAX_UPLOAD_FILE_SIZE=5368709120
# Size of each chunk the frontend splits a large upload into. Must match
# CHUNK_SIZE in frontend/src/api/client.js.
UPLOAD_CHUNK_SIZE=6291456



# Clip settings
MIN_CLIP_SECONDS=25
MAX_CLIP_SECONDS=130
MIN_CLIPS_PER_JOB=8
MAX_CLIPS_PER_JOB=30
MAX_CANDIDATE_CLIPS_PER_CHUNK=30

# Clip design (all optional, defaults shown)
# Output canvas size, vertical 9:16 for Shorts/Reels/TikTok. 720x1280 is the
# default; raise this for sharper output, but keep in mind that the
# renderer will still only use the best-moment portion of the source video,
# so a higher resolution won't magically make a blurry source look better.
CLIP_WIDTH=720
CLIP_HEIGHT=1280
# x264 encode quality/speed. ultrafast is the fastest option and the
# default; veryfast+23 looks a little cleaner but renders slower.
CLIP_VIDEO_PRESET=ultrafast
CLIP_VIDEO_CRF=28

# Performance tuning (all optional, defaults are sane)
# How many clips to render with ffmpeg at the same time. Defaults to
# min(4, CPU cores). Raising this speeds up jobs with many clips but uses
# more CPU/RAM per job — lower it if the server is small.
CLIP_RENDER_CONCURRENCY=
# Threads ffmpeg uses per individual clip render. Defaults to (CPU cores /
# CLIP_RENDER_CONCURRENCY) so concurrent renders share the machine evenly.
CLIP_RENDER_THREADS=
# Caps the resolution yt-dlp downloads at (video height, e.g. 720 = 720p).
# Defaults to CLIP_WIDTH, since that's all the renderer can use anyway —
# raise this only if you also raise CLIP_WIDTH/CLIP_HEIGHT for sharper output.
YTDLP_MAX_HEIGHT=720
# How many transcript chunks to send to the analysis LLM at once.
ANALYSIS_CONCURRENCY=4
# How many fragments yt-dlp downloads in parallel per video.
YTDLP_CONCURRENT_FRAGMENTS=16
# How many transcript chunks are sent to Groq's Whisper endpoint at once
TRANSCRIPTION_CONCURRENCY=4
MAX_TRANSCRIPTION_CHUNKS=10
